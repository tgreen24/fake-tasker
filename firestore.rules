rules_version = '2';

// Requires an identity, forbids enumeration, bounds the document, and pins
// host-only state to the uid that created the game.
//
// Still open by design: roles live in this shared document, so every player
// receives the imposter list. Votes, kills and task completion are keyed by
// display name, so a player can still write another player's entry. Closing
// those requires re-keying on uid and moving secrets to per-player documents.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function boundedGame(data) {
      return data.players is list
        && data.players.size() <= 25
        && data.creator is string
        && (!('tasks' in data.keys()) || (data.tasks is list && data.tasks.size() <= 60))
        && (!('killList' in data.keys()) || (data.killList is list && data.killList.size() <= 25));
    }

    // Only the account that created the game is the host. `creator` is a
    // display name and proves nothing.
    function isHost() {
      return request.auth.uid == resource.data.get('creatorUid', '');
    }

    // Fields only the host ever writes. Everything absent from this list is
    // written by ordinary play: votes, kills, task completion, meetings, and
    // the game-over flags any client may set when it detects a win.
    function hostOnlyFields() {
      return [
        'roles', 'assignedTasks', 'imposterHistory',
        'imposterCount', 'tasksPerCrewmate', 'killCooldown',
        'tasks', 'gameStarted', 'expiresAt', 'creator', 'creatorUid', 'roundStartedAt',
        'dealtSeats'
      ];
    }

    function touchesHostOnlyFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(hostOnlyFields());
    }

    // Joining grows the roster; only the host may remove a player.
    function removesPlayers() {
      return request.resource.data.players.size() < resource.data.players.size();
    }

    // Leaving is removing yourself, which rules cannot tell from kicking
    // unless the write says which seat went. playerUids maps that name to an
    // account. A seat with no account recorded is allowed through, because
    // being unable to leave is worse than an unverifiable departure.
    function leavesOwnSeat() {
      let leaver = request.resource.data.get('leftBy', '');
      let uids = resource.data.get('playerUids', {});
      return leaver != ''
        && request.resource.data.players.size() == resource.data.players.size() - 1
        && leaver in resource.data.players
        && !(leaver in request.resource.data.players)
        && (!(leaver in uids) || uids[leaver] == request.auth.uid);
    }

    match /games/{gameCode} {
      // A player needs to fetch a game by code to join it, but nobody may
      // list the collection and harvest every live game's roles.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && gameCode.size() == 6
        && boundedGame(request.resource.data)
        && request.resource.data.players.size() == 1
        && request.resource.data.creator == request.resource.data.players[0]
        && request.resource.data.creatorUid == request.auth.uid;

      allow update: if signedIn()
        && resource != null
        && boundedGame(request.resource.data)
        && request.resource.data.creator == resource.data.creator
        && request.resource.data.get('creatorUid', '') == resource.data.get('creatorUid', '')
        && (isHost() || (!touchesHostOnlyFields() && (!removesPlayers() || leavesOwnSeat())));

      allow delete: if signedIn() && isHost();

      // A player's role and task list. Readable only by the account holding
      // that seat, which is what stops every browser receiving the traitor
      // list. The host writes them all when dealing a round; after that only
      // the owner touches their own, to record task progress.
      match /players/{playerName} {
        function game() {
          return get(/databases/$(database)/documents/games/$(gameCode)).data;
        }
        function isGameHost() {
          return request.auth.uid == game().get('creatorUid', '');
        }
        function ownsSeat() {
          return resource != null && resource.data.get('uid', null) == request.auth.uid;
        }
        // The host stamps each seat with the account that announced it. If that
        // announcement had not landed when the round was dealt the seat is
        // unowned, and its player could otherwise never read or write their own
        // role. An unowned seat is claimable, once, without altering the role.
        // The field is written as null when the account was not yet known, so
        // an absent value and a null one both mean unclaimed.
        function seatIsUnclaimed() {
          return resource != null && resource.data.get('uid', null) == null;
        }
        function claimsSeat() {
          return seatIsUnclaimed()
            && request.resource.data.get('uid', null) == request.auth.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.tasks == resource.data.tasks;
        }

        allow get: if signedIn() && (ownsSeat() || seatIsUnclaimed());
        allow list: if false;

        allow create: if signedIn() && isGameHost();
        allow update: if signedIn() && (ownsSeat() || isGameHost() || claimsSeat());
        allow delete: if signedIn() && isGameHost();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
